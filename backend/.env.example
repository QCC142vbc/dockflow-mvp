SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5175,http://localhost:5173
JWT_ISSUER=dockflow-ecosystem
JWT_AUDIENCE=dockflow-api
SERVICE_AUTH_ISSUER=dock-appointment-scheduling
SERVICE_AUTH_AUDIENCE=dockflow-operations
